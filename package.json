{
  "name": "@random-mesh/rmsl",
  "version": "1.14.0",
  "keywords": [
    "shader",
    "dsl",
    "glsl",
    "wgsl",
    "webgpu",
    "webgl",
    "gpu",
    "cpu",
    "javascript",
    "node-graph",
    "typescript"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/big-mesh-studios/rmsl.git"
  },
  "homepage": "https://github.com/big-mesh-studios/rmsl#readme",
  "bugs": "https://github.com/big-mesh-studios/rmsl/issues",
  "files": [
    "dist"
  ],
  "main": "./dist/rmsl.js",
  "types": "./dist/rmsl.d.ts",
  "exports": {
    ".": {
      "import": "./dist/rmsl.js",
      "types": "./dist/rmsl.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./effects": {
      "import": "./dist/effects.js",
      "types": "./dist/effects/index.d.ts"
    },
    "./scene": {
      "import": "./dist/scene.js",
      "types": "./dist/scene/index.d.ts"
    },
    "./test": {
      "import": "./dist/test.js",
      "types": "./dist/test/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:setup": "playwright install chromium",
    "test:fast": "RMSL_SKIP_GPU=1 vitest run",
    "test:types": "vitest --typecheck.only --run",
    "test:mutate": "RMSL_SKIP_GPU=1 stryker run",
    "test:mutate:deep": "stryker run --timeoutMS 120000"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.71",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@kmamal/gpu": "^0.2.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vite": "^7.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@kmamal/gpu"
    ]
  }
}
